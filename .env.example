# Learnzzy env — never commit real secrets. AI keys stay server-side only.
APP_ENV=development
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Data layer - Docker containers (recommended)
# When running via `docker compose up` or `run.bat docker`, web/worker inside
# Docker use:
#   MONGODB_URI=mongodb://mongo:27017/learnzzy
#   REDIS_URL=redis://redis:6379
# Docker composes already sets these for web/worker internally.
# When running locally via `run.bat dev` or `npm run dev`, connect to the
# same Docker containers via host-mapped ports (mongo host port is 27018 to
# avoid clashing with other local MongoDB instances on default 27017):
MONGODB_URI=mongodb://127.0.0.1:27018/learnzzy_dev
MONGODB_DB_NAME=learnzzy_dev
REDIS_URL=redis://127.0.0.1:6379
# AI (server-only; never NEXT_PUBLIC_*)
AI_API_KEY=
AI_MODEL_NANO=gpt-5-nano
AI_MODEL_MINI=gpt-5-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000
AI_MAX_DAILY_REQUESTS=1000
AI_MAX_DAILY_COST_USD=10
# Education Gateway providers (all disabled by default; missing URL keeps provider disabled)
# Local Docker-first: each MCP runs as a private service on the learnzzy network.
#   Inside Docker web → http://tutor-mcp:3001  (service DNS, compose sets this via TUTOR_MCP_URL)
#   On host (npm run dev) → http://127.0.0.1:3001  (host-mapped port)
# Enable per-provider: set _ENABLED=true and point _URL to the correct host.
# Example for local Docker (compose already injects these defaults into web):
#   TUTOR_MCP_ENABLED=true
#   TUTOR_MCP_URL=http://tutor-mcp:3001
# For host dev against Docker MCPs:
#   TUTOR_MCP_URL=http://127.0.0.1:3001
TUTOR_MCP_ENABLED=false
TUTOR_MCP_URL=
TUTOR_MCP_API_KEY=
OER_MCP_ENABLED=false
OER_MCP_URL=
OER_MCP_API_KEY=
NCERT_MCP_ENABLED=false
NCERT_MCP_URL=
NCERT_MCP_API_KEY=
EDUCATION_GATEWAY_TIMEOUT_MS=5000
# Optional Qdrant (NCERT vector search) — private network; no host port in prod
QDRANT_URL=http://qdrant:6333
# For host dev, use: QDRANT_URL=http://127.0.0.1:6333
# Local Docker serves plain HTTP, so compose sets COOKIE_SECURE=false there.
# Host dev (NODE_ENV=development) never needs this. Production TLS keeps the
# default: Secure cookies. Only ever set "false" for local HTTP testing.
# COOKIE_SECURE=false
# Assets / observability (later)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
SESSION_SECRET=
ADMIN_AUTH_SECRET=
ADMIN_EMAIL=admin@learnzzy.local
ADMIN_PASSWORD_HASH=Test@1234
ADAPTIVE_ENGINE_ENABLED=true
