{
  "name": "learnzzy",
  "version": "0.1.0",
  "private": true,
  "description": "Learnzzy — Play. Think. Learn. Deterministic child learning playground PWA.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js tests/*.test.ts",
    "test:e2e": "playwright test",
    "seed": "node scripts/seed.mjs",
    "backup": "node scripts/backup.mjs",
    "worker": "node --loader ts-node/esm src/workers/worker.ts 2>&1 || node -r ts-node/register src/workers/worker.ts 2>&1 || echo 'worker requires ts-node or compiled output; in Docker use next build + node .next worker bootstrap'"
  },
  "dependencies": {
    "@sentry/nextjs": "^8.55.2",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "mongodb": "^7.6.0",
    "next": "14.2.5",
    "phaser": "3.80.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.39",
    "sharp": "^0.35.4",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
